<?xml version="1.0" encoding="utf-8"?>
<keyboard bottom_row="false" locale_extra_keys="false">
  <!--
    Dedicated maths layer.
    Tap Shift for capitals/superscripts and tap TeX for LaTeX output.
    Every normal key also exposes extra symbols with directional swipes.
  -->
  <row height="0.78">
    <key c="1" nw="¹" ne="!" sw="₁" se="∫" n="′" s="∑" w="∀" e="∃"/>
    <key c="2" nw="²" ne="√" sw="₂" se="∬" n="″" s="∏" w="∈" e="∉"/>
    <key c="3" nw="³" ne="∛" sw="₃" se="∭" n="‴" s="∂" w="∋" e="∌"/>
    <key c="4" nw="⁴" ne="∜" sw="₄" se="∮" n="⁄" s="∇" w="⊂" e="⊆"/>
    <key c="5" nw="⁵" ne="Σ" sw="₅" se="∑" n="‰" s="∆" w="⊃" e="⊇"/>
    <key c="6" nw="⁶" ne="Π" sw="₆" se="∏" n="∞" s="∝" w="∪" e="∩"/>
    <key c="7" nw="⁷" ne="≤" sw="₇" se="≪" n="⌊" s="⌈" w="←" e="→"/>
    <key c="8" nw="⁸" ne="≥" sw="₈" se="≫" n="⌋" s="⌉" w="⇐" e="⇒"/>
    <key c="9" nw="⁹" ne="≠" sw="₉" se="≈" n="±" s="∓" w="↔" e="⇔"/>
    <key c="0" nw="⁰" ne="%" sw="₀" se="°" n="∅" s="⌀" w="↦" e="⟼"/>
  </row>

  <row height="0.78">
    <key c="α" nw="∀" ne="∃" sw="∧" se="∨" n="¬" s="⇒" w="⇐" e="⇔"/>
    <key c="β" nw="∈" ne="∉" sw="∋" se="∌" n="⊂" s="⊆" w="⊃" e="⊇"/>
    <key c="γ" nw="∪" ne="∩" sw="∅" se="∖" n="⊕" s="⊗" w="⊙" e="⊖"/>
    <key c="δ" nw="ℕ" ne="ℤ" sw="ℚ" se="ℝ" n="ℂ" s="ℙ" w="ℍ" e="ℵ"/>
    <key c="ε" nw="ϵ" ne="∼" sw="≃" se="≅" n="≈" s="≡" w="≠" e="≐"/>
    <key c="ζ" nw="sin" ne="cos" sw="tan" se="cot" n="sec" s="csc" w="sinh" e="cosh"/>
    <key c="η" nw="arcsin" ne="arccos" sw="arctan" se="arg" n="ln" s="log" w="exp" e="lim"/>
    <key c="θ" nw="ϑ" ne="∠" sw="∡" se="⊥" n="°" s="′" w="″" e="‴"/>
    <key c="ι" nw="min" ne="max" sw="sup" se="inf" n="gcd" s="lcm" w="mod" e="div"/>
    <key c="κ" nw="det" ne="tr" sw="rank" se="ker" n="dim" s="span" w="im" e="null"/>
  </row>

  <row height="0.78">
    <key c="λ" nw="(" ne=")" sw="[" se="]" n="{" s="}" w="⟨" e="⟩"/>
    <key c="μ" nw="⌊" ne="⌋" sw="⌈" se="⌉" n="|" s="‖" w="⟦" e="⟧"/>
    <key c="ν" nw="←" ne="→" sw="↔" se="↦" n="↑" s="↓" w="⇐" e="⇒"/>
    <key c="ξ" nw="⟵" ne="⟶" sw="⟷" se="⟼" n="↗" s="↘" w="↖" e="↙"/>
    <key c="ο" nw="&lt;" ne="&gt;" sw="≤" se="≥" n="≪" s="≫" w="≺" e="≻"/>
    <key c="π" nw="∫" ne="∬" sw="∭" se="∮" n="∑" s="∏" w="∂" e="∇"/>
    <key c="ρ" nw="√" ne="∛" sw="∜" se="^" n="∞" s="∝" w="±" e="∓"/>
    <key c="σ" nw="ς" ne="E" sw="Var" se="Cov" n="Pr" s="x̄" w="ŷ" e="σ²"/>
    <key c="τ" nw="·" ne="×" sw="∘" se="∗" n="⊥" s="∥" w="∠" e="△"/>
    <key c="υ" nw="∴" ne="∵" sw="⊢" se="⊨" n="□" s="■" w="∎" e="QED"/>
  </row>

  <row height="0.78">
    <key width="1.5" role="action" c="shift" ne="capslock"/>
    <key c="φ" nw="ϕ" ne="Φ" sw="∅" se="⌀" n="floor" s="ceil" w="abs" e="sgn"/>
    <key c="χ" nw="⊕" ne="⊗" sw="⊙" se="⊖" n="⋂" s="⋃" w="⨯" e="⨉"/>
    <key c="ψ" nw="∴" ne="∵" sw="…" se="⋅" n="⋮" s="⋯" w="⋰" e="⋱"/>
    <key c="ω" nw="ℏ" ne="ℓ" sw="℘" se="ℑ" n="ℜ" s="℧" w="ℇ" e="℮"/>
    <key c="+" nw="−" ne="±" sw="∓" se="_" n="∪" s="∩" w="⊔" e="⊓"/>
    <key c="×" nw="÷" ne="·" sw="⋅" se="/" n="⊗" s="⊕" w="∗" e="⊙"/>
    <key c="=" nw="≠" ne="≈" sw="≡" se="≝" n="≤" s="≥" w="≲" e="≳"/>
    <key width="1.5" role="action" c="backspace" sw="delete"/>
  </row>

  <row height="0.95">
    <key width="1.2" role="action" c="switch_text" ne="loc esc"/>
    <key width="1.2" role="action" c="switch_numeric" ne="loc tab"/>
    <key width="1.2" role="action" c="TeX:fn"/>
    <key width="2.8" role="space_bar" c="space" nw="superscript" sw="subscript"
         w="cursor_left" e="cursor_right"/>
    <key width="1.2" role="action" c="switch_emoji" se="config"/>
    <key width="1.2" role="action" c="loc compose" n="up" e="right" w="left" s="down"/>
    <key width="1.2" role="action" c="enter" nw="=" ne="action"/>
  </row>

  <modmap>
    <!-- Shift is a compact second symbol layer. -->
    <shift a="1" b="¹"/><shift a="2" b="²"/><shift a="3" b="³"/>
    <shift a="4" b="⁴"/><shift a="5" b="⁵"/><shift a="6" b="⁶"/>
    <shift a="7" b="⁷"/><shift a="8" b="⁸"/><shift a="9" b="⁹"/>
    <shift a="0" b="⁰"/>
    <shift a="+" b="±"/><shift a="×" b="÷"/><shift a="=" b="≠"/>

    <shift a="α" b="Α"/><shift a="β" b="Β"/><shift a="γ" b="Γ"/>
    <shift a="δ" b="Δ"/><shift a="ε" b="Ε"/><shift a="ζ" b="Ζ"/>
    <shift a="η" b="Η"/><shift a="θ" b="Θ"/><shift a="ι" b="Ι"/>
    <shift a="κ" b="Κ"/><shift a="λ" b="Λ"/><shift a="μ" b="Μ"/>
    <shift a="ν" b="Ν"/><shift a="ξ" b="Ξ"/><shift a="ο" b="Ο"/>
    <shift a="π" b="Π"/><shift a="ρ" b="Ρ"/><shift a="σ" b="Σ"/>
    <shift a="τ" b="Τ"/><shift a="υ" b="Υ"/><shift a="φ" b="Φ"/>
    <shift a="χ" b="Χ"/><shift a="ψ" b="Ψ"/><shift a="ω" b="Ω"/>

    <shift a="sin" b="arcsin"/><shift a="cos" b="arccos"/>
    <shift a="tan" b="arctan"/><shift a="sinh" b="arsinh"/>
    <shift a="cosh" b="arcosh"/>

    <!-- TeX/Fn turns symbols into compact LaTeX commands and templates. -->
    <fn a="0" b="0"/><fn a="1" b="1"/><fn a="2" b="2"/>
    <fn a="3" b="3"/><fn a="4" b="4"/><fn a="5" b="5"/>
    <fn a="6" b="6"/><fn a="7" b="7"/><fn a="8" b="8"/>
    <fn a="9" b="9"/>

    <fn a="α" b="α:'\\alpha'"/><fn a="β" b="β:'\\beta'"/>
    <fn a="γ" b="γ:'\\gamma'"/><fn a="δ" b="δ:'\\delta'"/>
    <fn a="ε" b="ε:'\\epsilon'"/><fn a="ϵ" b="ϵ:'\\varepsilon'"/>
    <fn a="ζ" b="ζ:'\\zeta'"/><fn a="η" b="η:'\\eta'"/>
    <fn a="θ" b="θ:'\\theta'"/><fn a="ϑ" b="ϑ:'\\vartheta'"/>
    <fn a="ι" b="ι:'\\iota'"/><fn a="κ" b="κ:'\\kappa'"/>
    <fn a="λ" b="λ:'\\lambda'"/><fn a="μ" b="μ:'\\mu'"/>
    <fn a="ν" b="ν:'\\nu'"/><fn a="ξ" b="ξ:'\\xi'"/>
    <fn a="ο" b="o:'o'"/><fn a="π" b="π:'\\pi'"/>
    <fn a="ρ" b="ρ:'\\rho'"/><fn a="σ" b="σ:'\\sigma'"/>
    <fn a="ς" b="ς:'\\varsigma'"/><fn a="τ" b="τ:'\\tau'"/>
    <fn a="υ" b="υ:'\\upsilon'"/><fn a="φ" b="φ:'\\phi'"/>
    <fn a="ϕ" b="ϕ:'\\varphi'"/><fn a="χ" b="χ:'\\chi'"/>
    <fn a="ψ" b="ψ:'\\psi'"/><fn a="ω" b="ω:'\\omega'"/>

    <fn a="Γ" b="Γ:'\\Gamma'"/><fn a="Δ" b="Δ:'\\Delta'"/>
    <fn a="Θ" b="Θ:'\\Theta'"/><fn a="Λ" b="Λ:'\\Lambda'"/>
    <fn a="Ξ" b="Ξ:'\\Xi'"/><fn a="Π" b="Π:'\\Pi'"/>
    <fn a="Σ" b="Σ:'\\Sigma'"/><fn a="Υ" b="Υ:'\\Upsilon'"/>
    <fn a="Φ" b="Φ:'\\Phi'"/><fn a="Ψ" b="Ψ:'\\Psi'"/>
    <fn a="Ω" b="Ω:'\\Omega'"/>

    <fn a="∫" b="∫:'\\int_{}^{}'"/><fn a="∬" b="∬:'\\iint_{}'"/>
    <fn a="∭" b="∭:'\\iiint_{}'"/><fn a="∮" b="∮:'\\oint_{}'"/>
    <fn a="∑" b="∑:'\\sum_{i=1}^{n}'"/><fn a="∏" b="∏:'\\prod_{i=1}^{n}'"/>
    <fn a="√" b="√:'\\sqrt{}'"/><fn a="∛" b="∛:'\\sqrt[3]{}'"/>
    <fn a="∜" b="∜:'\\sqrt[4]{}'"/><fn a="∞" b="∞:'\\infty'"/>
    <fn a="∂" b="∂:'\\partial'"/><fn a="∇" b="∇:'\\nabla'"/>
    <fn a="∆" b="Δ:'\\Delta'"/>

    <fn a="sin" b="sin:'\\sin'"/><fn a="cos" b="cos:'\\cos'"/>
    <fn a="tan" b="tan:'\\tan'"/><fn a="cot" b="cot:'\\cot'"/>
    <fn a="sec" b="sec:'\\sec'"/><fn a="csc" b="csc:'\\csc'"/>
    <fn a="sinh" b="sinh:'\\sinh'"/><fn a="cosh" b="cosh:'\\cosh'"/>
    <fn a="arcsin" b="asin:'\\arcsin'"/><fn a="arccos" b="acos:'\\arccos'"/>
    <fn a="arctan" b="atan:'\\arctan'"/><fn a="arg" b="arg:'\\arg'"/>
    <fn a="ln" b="ln:'\\ln'"/><fn a="log" b="log:'\\log'"/>
    <fn a="exp" b="exp:'\\exp'"/><fn a="lim" b="lim:'\\lim_{}'"/>
    <fn a="min" b="min:'\\min'"/><fn a="max" b="max:'\\max'"/>
    <fn a="sup" b="sup:'\\sup'"/><fn a="inf" b="inf:'\\inf'"/>
    <fn a="gcd" b="gcd:'\\gcd'"/><fn a="det" b="det:'\\det'"/>
    <fn a="ker" b="ker:'\\ker'"/><fn a="dim" b="dim:'\\dim'"/>
    <fn a="mod" b="mod:'\\bmod'"/><fn a="span" b="span:'\\operatorname{span}'"/>
    <fn a="rank" b="rank:'\\operatorname{rank}'"/>
    <fn a="tr" b="tr:'\\operatorname{tr}'"/>
    <fn a="lcm" b="lcm:'\\operatorname{lcm}'"/>
    <fn a="floor" b="floor:'\\lfloor\\rfloor'"/>
    <fn a="ceil" b="ceil:'\\lceil\\rceil'"/>
    <fn a="abs" b="abs:'\\left|\\right|'"/>
    <fn a="sgn" b="sgn:'\\operatorname{sgn}'"/>

    <fn a="ℕ" b="N:'\\mathbb{N}'"/><fn a="ℤ" b="Z:'\\mathbb{Z}'"/>
    <fn a="ℚ" b="Q:'\\mathbb{Q}'"/><fn a="ℝ" b="R:'\\mathbb{R}'"/>
    <fn a="ℂ" b="C:'\\mathbb{C}'"/><fn a="ℙ" b="P:'\\mathbb{P}'"/>
    <fn a="ℍ" b="H:'\\mathbb{H}'"/><fn a="ℵ" b="ℵ:'\\aleph'"/>

    <fn a="∀" b="∀:'\\forall'"/><fn a="∃" b="∃:'\\exists'"/>
    <fn a="¬" b="¬:'\\neg'"/><fn a="∧" b="∧:'\\land'"/>
    <fn a="∨" b="∨:'\\lor'"/><fn a="⇒" b="⇒:'\\Rightarrow'"/>
    <fn a="⇐" b="⇐:'\\Leftarrow'"/><fn a="⇔" b="⇔:'\\Leftrightarrow'"/>
    <fn a="∈" b="∈:'\\in'"/><fn a="∉" b="∉:'\\notin'"/>
    <fn a="∋" b="∋:'\\ni'"/><fn a="∅" b="∅:'\\varnothing'"/>
    <fn a="⊂" b="⊂:'\\subset'"/><fn a="⊆" b="⊆:'\\subseteq'"/>
    <fn a="⊃" b="⊃:'\\supset'"/><fn a="⊇" b="⊇:'\\supseteq'"/>
    <fn a="∪" b="∪:'\\cup'"/><fn a="∩" b="∩:'\\cap'"/>
    <fn a="∖" b="∖:'\\setminus'"/>

    <fn a="&lt;" b="&lt;"/><fn a="&gt;" b="&gt;"/>
    <fn a="≤" b="≤:'\\leq'"/><fn a="≥" b="≥:'\\geq'"/>
    <fn a="≠" b="≠:'\\neq'"/><fn a="≈" b="≈:'\\approx'"/>
    <fn a="≃" b="≃:'\\simeq'"/><fn a="≅" b="≅:'\\cong'"/>
    <fn a="≡" b="≡:'\\equiv'"/><fn a="∼" b="∼:'\\sim'"/>
    <fn a="≪" b="≪:'\\ll'"/><fn a="≫" b="≫:'\\gg'"/>
    <fn a="+" b="+"/><fn a="−" b="−"/><fn a="=" b="="/>
    <fn a="_" b="_:'_{}'"/><fn a="^" b="^:'^{}'"/>
    <fn a="/" b="frac:'\\frac{}{}'"/>
    <fn a="±" b="±:'\\pm'"/><fn a="∓" b="∓:'\\mp'"/>
    <fn a="×" b="×:'\\times'"/><fn a="÷" b="÷:'\\div'"/>
    <fn a="·" b="·:'\\cdot'"/><fn a="⋅" b="⋅:'\\cdot'"/>
    <fn a="∘" b="∘:'\\circ'"/><fn a="⊗" b="⊗:'\\otimes'"/>
    <fn a="⊕" b="⊕:'\\oplus'"/><fn a="⊙" b="⊙:'\\odot'"/>
    <fn a="⊥" b="⊥:'\\perp'"/><fn a="∥" b="∥:'\\parallel'"/>
    <fn a="∝" b="∝:'\\propto'"/>

    <fn a="←" b="←:'\\leftarrow'"/><fn a="→" b="→:'\\rightarrow'"/>
    <fn a="↔" b="↔:'\\leftrightarrow'"/><fn a="↦" b="↦:'\\mapsto'"/>
    <fn a="↑" b="↑:'\\uparrow'"/><fn a="↓" b="↓:'\\downarrow'"/>
    <fn a="⟵" b="⟵:'\\longleftarrow'"/><fn a="⟶" b="⟶:'\\longrightarrow'"/>
    <fn a="⟷" b="⟷:'\\longleftrightarrow'"/><fn a="⟼" b="⟼:'\\longmapsto'"/>

    <fn a="(" b="(:'\\left('"/><fn a=")" b="):'\\right)'"/>
    <fn a="[" b="[:'\\left['"/><fn a="]" b="]:'\\right]'"/>
    <fn a="{" b="{:'\\left\\{'"/><fn a="}" b="}:'\\right\\}'"/>
    <fn a="⟨" b="⟨:'\\langle'"/><fn a="⟩" b="⟩:'\\rangle'"/>
    <fn a="⌊" b="⌊:'\\lfloor'"/><fn a="⌋" b="⌋:'\\rfloor'"/>
    <fn a="⌈" b="⌈:'\\lceil'"/><fn a="⌉" b="⌉:'\\rceil'"/>
    <fn a="‖" b="‖:'\\lVert\\rVert'"/>

    <fn a="E" b="E:'\\mathbb{E}'"/><fn a="Var" b="Var:'\\operatorname{Var}'"/>
    <fn a="Cov" b="Cov:'\\operatorname{Cov}'"/><fn a="Pr" b="Pr:'\\Pr'"/>
    <fn a="x̄" b="x̄:'\\bar{x}'"/><fn a="ŷ" b="ŷ:'\\hat{y}'"/>
    <fn a="σ²" b="σ²:'\\sigma^2'"/><fn a="QED" b="QED:'\\qed'"/>
    <fn a="ℏ" b="ℏ:'\\hbar'"/><fn a="ℓ" b="ℓ:'\\ell'"/>
  </modmap>
</keyboard>
