<?xml version="1.0" encoding="utf-8"?>
<keyboard name="QWERTY (Greek)" script="greek">
  <row>
    <key key0=";" key2="1" key4="loc esc"/>
    <key key0="ς" key1="~" key2="2" key3="\@"/>
    <key key0="ε" key1="!" key2="3" key3="ἐ" key4="ἑ"/>
    <key key0="ρ" key1="#" key2="4" key3="$" key4="€"/>
    <key key0="τ" key2="5" key3="%"/>
    <key key0="υ" key1="^" key2="6" key3="ὐ" key4="ὑ"/>
    <key key0="θ" key1="&amp;" key2="7" key3="(" key4=")"/>
    <key key0="ι" key1="*" key2="8" key3="ἰ" key4="ἱ"/>
    <key key0="ο" key2="9" key3="ὀ" key4="ὁ"/>
    <key key0="π" key2="0"/>
  </row>
  <row>
    <key key0="α" key1="loc tab" key2="`" key3="ἀ" key4="ἁ"/>
    <key key0="σ"/>
    <key key0="δ" key2="loc £"/>
    <key key0="φ"/>
    <key key0="γ" key2="-" key3="_"/>
    <key key0="η" key1="+" key2="=" key3="ἠ" key4="ἡ"/>
    <key key0="ξ" key3="{" key4="}"/>
    <key key0="κ" key3="[" key4="]"/>
    <key key0="λ" key2="|" key3="\\"/>
    <key key0="accent_aigu" key1="accent_trema" key2="accent_tilde" key3="accent_grave"/>
  </row>
  <row>
    <key width="1.5" role="action" key0="shift" key2="loc capslock"/>
    <key key0="ζ"/>
    <key key0="χ"/>
    <key key0="ψ" key1="&lt;" key2="&gt;"/>
    <key key0="ω" key1="," key2="." key3="ὠ" key4="ὡ"/>
    <key key0="β" key2="\?" key3="/"/>
    <key key0="ν" key1=";" key2=":"/>
    <key key0="μ" key2="&quot;" key3="'"/>
    <key width="1.5" role="action" key0="backspace" key2="delete"/>
  </row>
</keyboard>
